@startuml
scale 0.75
top to bottom direction

skinparam defaultFontName Arial
skinparam defaultFontSize 30
skinparam titleFontSize 40
skinparam componentFontSize 30
skinparam packageFontSize 34
skinparam interfaceFontSize 28
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 45

skinparam componentStyle rectangle
skinparam packageStyle rectangle

skinparam componentBackgroundColor #C3D5FF
skinparam componentBorderColor #000000
skinparam componentFontColor #000000

skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
skinparam packageFontColor #000000

skinparam actorBackgroundColor #000000
skinparam actorBorderColor #000000
skinparam actorFontColor #000000

skinparam databaseBackgroundColor #FFFFFF
skinparam databaseBorderColor #000000
skinparam databaseFontColor #000000

skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #000000
skinparam rectangleFontColor #000000

skinparam arrowColor #000000
skinparam titleBorderColor #000000

title ECS 1D Blood Flow Visualization - Component Diagram

actor User

package "Launch Pipeline" {
  component "Launcher\nrun_all.bat / run_all.ps1" as Launcher
  component "OpenBF Runner\nrun_openbf.jl" as OpenBFRunner
  component "YAML Converter\nadan56_yaml_to_json.py" as YamlConverter
}

package "Simulation Artifacts" {
  rectangle "adan56.yaml" as YamlConfig
  folder "openBF *_results" as ResultsFolder
  folder "StreamingAssets/LastFiles" as LastFiles
  rectangle "StreamingAssets/vessels.json" as VesselsJson
}

package "Unity Application" {
  component "Unity Player" as UnityPlayer
  component "ECS Bootstrap\nEcsWorldBootstrap" as Bootstrap
  database "EcsWorld\nNodes, VesselTopology,\nVesselSim, SegmentRender,\nBoneFollows, Material state" as World

  component "Network Load System" as NetworkLoad
  component "Simulation Load System" as SimulationLoad
  component "Chain Mapping System" as ChainMapping
  component "Vessel Ontology Parser" as Ontology
  component "Vessel Build System" as VesselBuild
  component "Bone Follow System" as BoneFollow
  component "Segment Align System" as SegmentAlign
  component "Simulation Playback System" as Playback
  component "Heartbeat Controller" as Heartbeat
  component "Vessel Name Picker" as Picker

  component "Skeleton Rig / Animator" as Skeleton
  component "Vessel Mesh Prefab Instances" as VesselMeshes
  component "UI Controls\nBPM, diameter, metric,\nmovement, audio, visibility" as UI
}

User --> Launcher : start simulation + app
Launcher --> OpenBFRunner : execute simulation
OpenBFRunner --> YamlConfig : read model input
OpenBFRunner --> ResultsFolder : write *.last outputs

Launcher --> YamlConverter : convert topology
YamlConverter --> YamlConfig : read vessel network
YamlConverter --> VesselsJson : write wrapped JSON

Launcher --> LastFiles : copy newest *.last files
Launcher --> UnityPlayer : launch executable

UnityPlayer --> Bootstrap : initialize world
Bootstrap --> World : create EcsWorld

UnityPlayer --> NetworkLoad : startup load
NetworkLoad --> VesselsJson : read topology JSON
NetworkLoad --> World : create node + vessel entities

UnityPlayer --> SimulationLoad : startup load
SimulationLoad --> LastFiles : read A/P/Q .last files
SimulationLoad --> World : populate VesselSim\n+ global min/max ranges

UnityPlayer --> ChainMapping : startup mapping
ChainMapping --> Ontology : parse vessel labels\ninfer region + side
ChainMapping --> Skeleton : inspect bones / body parts
ChainMapping --> World : assign anchors\n+ BoneFollows

UnityPlayer --> VesselBuild : instantiate geometry
VesselBuild --> World : read topology + anchors\ncreate SegmentRender + materials
VesselBuild --> VesselMeshes : build vessel roots\nand subsegments

BoneFollow --> World : update anchor transforms
BoneFollow --> Skeleton : follow animated bones

SegmentAlign --> World : read anchors + segment data
SegmentAlign --> VesselMeshes : position, rotate,\nlength-scale segments

Heartbeat --> UI : bind sliders / dropdowns
Heartbeat --> Playback : set phase,\ndiameter scale, metric
Heartbeat --> Skeleton : drive animator speed\n+ movement controller

Playback --> World : sample pressure / flow / area
Playback --> VesselMeshes : update color\nand diameter

Picker --> UI : show selected vessel name
Picker --> VesselMeshes : raycast selectable vessels
User --> UI : adjust controls
User --> Picker : click vessel

' Layout hints
Launcher -[hidden]down- UnityPlayer
ResultsFolder -[hidden]down- LastFiles
VesselsJson -[hidden]down- NetworkLoad
LastFiles -[hidden]down- SimulationLoad
World -[hidden]down- Playback
Skeleton -[hidden]right- VesselMeshes
UI -[hidden]left- Heartbeat

@enduml
