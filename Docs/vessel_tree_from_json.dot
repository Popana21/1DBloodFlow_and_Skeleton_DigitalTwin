digraph VesselTree {
  graph [rankdir=TB, splines=spline, newrank=true, overlap=false, nodesep=0.35, ranksep=0.75, pad=0.15];
  node  [shape=circle, width=0.24, fixedsize=true, fontsize=10, fontname="Helvetica", color="#6B7280", penwidth=1.0];
  edge  [fontsize=8, fontname="Helvetica", color="#4B5563", arrowsize=0.6, penwidth=1.0];
  labelloc="t";
  label="OpenBF Vessel Tree (Graphviz DOT from vessels.json)";
  ordering=out;
  // Spline routing helps show the aortic arch and branch curvature.
  splines=spline;

  // Layout guide nodes to keep arm subtrees on opposite sides of the trunk.
  TrunkGuideLeft  [shape=point, width=0.01, label="", style=invis, group="left_guide"];
  TrunkGuideRight [shape=point, width=0.01, label="", style=invis, group="right_guide"];
  { rank=same; TrunkGuideLeft; N2; TrunkGuideRight; }
  TrunkGuideLeft -> N2 [style=invis, weight=200, minlen=1, constraint=true];
  N2 -> TrunkGuideRight [style=invis, weight=200, minlen=1, constraint=true];
  ArmGuideLeft  [shape=point, width=0.01, label="", style=invis, group="left_guide"];
  ArmGuideRight [shape=point, width=0.01, label="", style=invis, group="right_guide"];
  { rank=same; ArmGuideLeft; N3; N4; ArmGuideRight; }
  TrunkGuideLeft -> ArmGuideLeft [style=invis, weight=80, minlen=1, constraint=true];
  ArmGuideRight -> TrunkGuideRight [style=invis, weight=80, minlen=1, constraint=true];
  ArmGuideLeft -> N3 [style=invis, weight=120, minlen=1, constraint=true];
  N4 -> ArmGuideRight [style=invis, weight=120, minlen=1, constraint=true];
  // Force arm roots to opposite sides.
  ArmGuideLeft -> N5 [style=invis, weight=140, minlen=1, constraint=true];
  ArmGuideRight -> N22 [style=invis, weight=140, minlen=1, constraint=true];
  // Hard ordering pins arm roots around trunk: left-pad -> N5 -> N2 -> N22 -> right-pad.
  SidePadLeft [shape=point, width=0.01, label="", style=invis];
  SidePadRight [shape=point, width=0.01, label="", style=invis];
  { rank=same; SidePadLeft; N5; N2; N22; SidePadRight; }
  SidePadLeft -> N5 [style=invis, weight=260, minlen=1, constraint=true];
  N5 -> N2 [style=invis, weight=220, minlen=1, constraint=true];
  N2 -> N22 [style=invis, weight=220, minlen=1, constraint=true];
  N22 -> SidePadRight [style=invis, weight=260, minlen=1, constraint=true];

  // Keep posterior intercostals on their corresponding mirrored sides.
  ArmGuideLeft -> N34 [style=invis, weight=80, minlen=1, constraint=true];
  ArmGuideLeft -> N38 [style=invis, weight=80, minlen=1, constraint=true];
  ArmGuideRight -> N36 [style=invis, weight=80, minlen=1, constraint=true];
  ArmGuideRight -> N40 [style=invis, weight=80, minlen=1, constraint=true];

  // Node declarations (group helps keep left/center/right columns stable).
  N1 [label="1", group="center", style=filled, fillcolor="#F9FAFB"];
  N2 [label="2", group="center", style=filled, fillcolor="#F9FAFB"];
  N3 [label="3", group="center", style=filled, fillcolor="#F9FAFB"];
  N4 [label="4", group="center", style=filled, fillcolor="#F9FAFB"];
  N5 [label="5", group="left", style=filled, fillcolor="#EEF2FF"];
  N6 [label="6", group="left", style=filled, fillcolor="#EEF2FF"];
  N7 [label="7", group="left", style=filled, fillcolor="#EEF2FF"];
  N8 [label="8", group="left", style=filled, fillcolor="#EEF2FF"];
  N9 [label="9", group="left", style=filled, fillcolor="#EEF2FF"];
  N10 [label="10", group="left", style=filled, fillcolor="#EEF2FF"];
  N11 [label="11", group="left", style=filled, fillcolor="#EEF2FF"];
  N12 [label="12", group="left", style=filled, fillcolor="#EEF2FF"];
  N13 [label="13", group="left", style=filled, fillcolor="#EEF2FF"];
  N14 [label="14", group="left", style=filled, fillcolor="#EEF2FF"];
  N15 [label="15", group="left", style=filled, fillcolor="#EEF2FF"];
  N16 [label="16", group="left", style=filled, fillcolor="#EEF2FF"];
  N17 [label="17", group="left", style=filled, fillcolor="#EEF2FF"];
  N18 [label="18", group="right", style=filled, fillcolor="#ECFDF5"];
  N19 [label="19", group="center", style=filled, fillcolor="#F9FAFB"];
  N20 [label="20", group="right", style=filled, fillcolor="#ECFDF5"];
  N21 [label="21", group="right", style=filled, fillcolor="#ECFDF5"];
  N22 [label="22", group="right", style=filled, fillcolor="#ECFDF5"];
  N23 [label="23", group="center", style=filled, fillcolor="#F9FAFB"];
  N24 [label="24", group="right", style=filled, fillcolor="#ECFDF5"];
  N25 [label="25", group="right", style=filled, fillcolor="#ECFDF5"];
  N26 [label="26", group="right", style=filled, fillcolor="#ECFDF5"];
  N27 [label="27", group="right", style=filled, fillcolor="#ECFDF5"];
  N28 [label="28", group="right", style=filled, fillcolor="#ECFDF5"];
  N29 [label="29", group="right", style=filled, fillcolor="#ECFDF5"];
  N30 [label="30", group="right", style=filled, fillcolor="#ECFDF5"];
  N31 [label="31", group="right", style=filled, fillcolor="#ECFDF5"];
  N32 [label="32", group="right", style=filled, fillcolor="#ECFDF5"];
  N33 [label="33", group="center", style=filled, fillcolor="#F9FAFB"];
  N34 [label="34", group="left", style=filled, fillcolor="#EEF2FF"];
  N35 [label="35", group="center", style=filled, fillcolor="#F9FAFB"];
  N36 [label="36", group="right", style=filled, fillcolor="#ECFDF5"];
  N37 [label="37", group="center", style=filled, fillcolor="#F9FAFB"];
  N38 [label="38", group="left", style=filled, fillcolor="#EEF2FF"];
  N39 [label="39", group="center", style=filled, fillcolor="#F9FAFB"];
  N40 [label="40", group="right", style=filled, fillcolor="#ECFDF5"];
  N41 [label="41", group="center", style=filled, fillcolor="#F9FAFB"];
  N42 [label="42", group="center", style=filled, fillcolor="#F9FAFB"];
  N43 [label="43", group="center", style=filled, fillcolor="#F9FAFB"];
  N44 [label="44", group="center", style=filled, fillcolor="#F9FAFB"];
  N45 [label="45", group="center", style=filled, fillcolor="#F9FAFB"];
  N46 [label="46", group="center", style=filled, fillcolor="#F9FAFB"];
  N47 [label="47", group="right", style=filled, fillcolor="#ECFDF5"];
  N48 [label="48", group="center", style=filled, fillcolor="#F9FAFB"];
  N49 [label="49", group="center", style=filled, fillcolor="#F9FAFB"];
  N50 [label="50", group="center", style=filled, fillcolor="#F9FAFB"];
  N51 [label="51", group="right", style=filled, fillcolor="#ECFDF5"];
  N52 [label="52", group="center", style=filled, fillcolor="#F9FAFB"];
  N53 [label="53", group="left", style=filled, fillcolor="#EEF2FF"];
  N54 [label="54", group="center", style=filled, fillcolor="#F9FAFB"];
  N55 [label="55", group="center", style=filled, fillcolor="#F9FAFB"];
  N56 [label="56", group="center", style=filled, fillcolor="#F9FAFB"];
  N57 [label="57", group="left", style=filled, fillcolor="#EEF2FF"];
  N58 [label="58", group="right", style=filled, fillcolor="#ECFDF5"];
  N59 [label="59", group="left", style=filled, fillcolor="#EEF2FF"];
  N60 [label="60", group="left", style=filled, fillcolor="#EEF2FF"];
  N61 [label="61", group="left", style=filled, fillcolor="#EEF2FF"];
  N62 [label="62", group="left", style=filled, fillcolor="#EEF2FF"];
  N63 [label="63", group="left", style=filled, fillcolor="#EEF2FF"];
  N64 [label="64", group="left", style=filled, fillcolor="#EEF2FF"];
  N65 [label="65", group="left", style=filled, fillcolor="#EEF2FF"];
  N66 [label="66", group="left", style=filled, fillcolor="#EEF2FF"];
  N67 [label="67", group="left", style=filled, fillcolor="#EEF2FF"];
  N68 [label="68", group="left", style=filled, fillcolor="#EEF2FF"];
  N69 [label="69", group="right", style=filled, fillcolor="#ECFDF5"];
  N70 [label="70", group="right", style=filled, fillcolor="#ECFDF5"];
  N71 [label="71", group="right", style=filled, fillcolor="#ECFDF5"];
  N72 [label="72", group="right", style=filled, fillcolor="#ECFDF5"];
  N73 [label="73", group="right", style=filled, fillcolor="#ECFDF5"];
  N74 [label="74", group="right", style=filled, fillcolor="#ECFDF5"];
  N75 [label="75", group="right", style=filled, fillcolor="#ECFDF5"];
  N76 [label="76", group="right", style=filled, fillcolor="#ECFDF5"];
  N77 [label="77", group="right", style=filled, fillcolor="#ECFDF5"];
  N78 [label="78", group="right", style=filled, fillcolor="#ECFDF5"];

  // Strong trunk constraints keep the aorta vertical.
  N1 -> N2 [label="aortic_arch_I", color="#0F766E", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N2 -> N4 [label="aortic_arch_II", color="#0F766E", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N4 -> N19 [label="aortic_arch_III", color="#0F766E", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N19 -> N23 [label="aortic_arch_IV", color="#0F766E", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N23 -> N33 [label="thoracic_aorta_I", color="#0E7490", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N33 -> N35 [label="thoracic_aorta_II", color="#0E7490", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N35 -> N37 [label="thoracic_aorta_III", color="#0E7490", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N37 -> N39 [label="thoracic_aorta_IV", color="#0E7490", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N39 -> N41 [label="thoracic_aorta_V", color="#0E7490", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N41 -> N42 [label="thoracic_aorta_VI", color="#0E7490", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N42 -> N44 [label="abdominal_aorta_I", color="#7C3AED", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N44 -> N50 [label="abdominal_aorta_II", color="#7C3AED", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N50 -> N52 [label="abdominal_aorta_III", color="#7C3AED", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N52 -> N54 [label="abdominal_aorta_IV", color="#7C3AED", penwidth=2.4, weight=40, minlen=1, constraint=true];
  N54 -> N56 [label="abdominal_aorta_V", color="#7C3AED", penwidth=2.4, weight=40, minlen=1, constraint=true];

  // Keep neck/head vessels above parent nodes (anatomical upward direction).
  N6 -> N3 [style=invis, weight=120, minlen=1, constraint=true];
  N18 -> N4 [style=invis, weight=120, minlen=1, constraint=true];
  N7 -> N5 [style=invis, weight=120, minlen=1, constraint=true];
  N24 -> N22 [style=invis, weight=120, minlen=1, constraint=true];
  N16 -> N6 [style=invis, weight=140, minlen=1, constraint=true];
  N17 -> N6 [style=invis, weight=140, minlen=1, constraint=true];
  N20 -> N18 [style=invis, weight=140, minlen=1, constraint=true];
  N21 -> N18 [style=invis, weight=140, minlen=1, constraint=true];
  { rank=same; N16; N17; N20; N21; }

  // Side branches: lower weight so they do not bend the trunk.
  N2 -> N3 [label="brachiocephalic_trunk", color="#0F766E", weight=2, minlen=1, constraint=true];
  N3 -> N5 [label="subclavian_R_I", color="#0F766E", weight=10, minlen=1, constraint=true];
  N3 -> N6 [label="common_carotid_R", color="#F59E0B", weight=3, minlen=1, constraint=false, tailport=n, headport=s];
  N5 -> N7 [label="vertebral_R", color="#F59E0B", weight=3, minlen=1, constraint=false, tailport=n, headport=s];
  N5 -> N8 [label="subclavian_R_II", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N8 -> N9 [label="axillary_R", color="#2563EB", weight=2, minlen=1, constraint=true];
  N9 -> N10 [label="brachial_R", color="#2563EB", weight=2, minlen=1, constraint=true];
  N10 -> N11 [label="radial_R", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N10 -> N12 [label="ulnar_R_I", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N12 -> N13 [label="common_interosseous_R", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N12 -> N14 [label="ulnar_R_II", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N13 -> N15 [label="posterior_interosseous_R", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N6 -> N16 [label="external_carotid_R", color="#EF4444", weight=4, minlen=1, constraint=false, tailport=n, headport=s];
  N6 -> N17 [label="internal_carotid_R", color="#EF4444", weight=4, minlen=1, constraint=false, tailport=n, headport=s];
  N4 -> N18 [label="common_carotid_L", color="#F59E0B", weight=3, minlen=1, constraint=false, tailport=n, headport=s];
  N18 -> N20 [label="external_carotid_L", color="#EF4444", weight=4, minlen=1, constraint=false, tailport=n, headport=s];
  N18 -> N21 [label="internal_carotid_L", color="#EF4444", weight=4, minlen=1, constraint=false, tailport=n, headport=s];
  N19 -> N22 [label="subclavian_L_I", color="#0F766E", weight=10, minlen=1, constraint=true];
  N22 -> N24 [label="vertebral_L", color="#F59E0B", weight=3, minlen=1, constraint=false, tailport=n, headport=s];
  N22 -> N25 [label="subclavian_L_II", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N25 -> N26 [label="axillary_L", color="#2563EB", weight=2, minlen=1, constraint=true];
  N26 -> N27 [label="brachial_L", color="#2563EB", weight=2, minlen=1, constraint=true];
  N27 -> N28 [label="radial_L", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N27 -> N29 [label="ulnar_L_I", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N29 -> N30 [label="common_interosseous_L", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N29 -> N31 [label="ulnar_L_II", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N30 -> N32 [label="posterior_interosseous_L", color="#1D4ED8", weight=2, minlen=1, constraint=true];
  N33 -> N34 [label="posterior_intercostal_T6_R", color="#0E7490", weight=2, minlen=1, constraint=true];
  N35 -> N36 [label="posterior_intercostal_T6_L", color="#0E7490", weight=2, minlen=1, constraint=true];
  N37 -> N38 [label="posterior_intercostal_T7_R", color="#0E7490", weight=2, minlen=1, constraint=true];
  N39 -> N40 [label="posterior_intercostal_T7_L", color="#0E7490", weight=2, minlen=1, constraint=true];
  N42 -> N43 [label="celiac_trunk", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N43 -> N45 [label="common_hepatic", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N43 -> N46 [label="splenic_I", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N46 -> N47 [label="left_gastric", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N46 -> N48 [label="splenic_II", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N44 -> N49 [label="superior_mesenteric", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N50 -> N51 [label="renal_L", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N52 -> N53 [label="renal_R", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N54 -> N55 [label="inferior_mesenteric", color="#7C3AED", weight=2, minlen=1, constraint=true];
  N56 -> N57 [label="common_iliac_R", color="#D97706", weight=2, minlen=1, constraint=true];
  N56 -> N58 [label="common_iliac_L", color="#D97706", weight=2, minlen=1, constraint=true];
  N57 -> N59 [label="external_iliac_R", color="#D97706", weight=2, minlen=1, constraint=true];
  N57 -> N60 [label="internal_iliac_R", color="#D97706", weight=2, minlen=1, constraint=true];
  N59 -> N61 [label="femoral_R_I", color="#059669", weight=2, minlen=1, constraint=true];
  N61 -> N62 [label="profunda_femoris_R", color="#059669", weight=2, minlen=1, constraint=true];
  N61 -> N63 [label="femoral_R_II", color="#059669", weight=2, minlen=1, constraint=true];
  N63 -> N64 [label="popliteal_R_I", color="#059669", weight=2, minlen=1, constraint=true];
  N64 -> N65 [label="anterior_tibial_R", color="#0F766E", weight=2, minlen=1, constraint=true];
  N64 -> N66 [label="popliteal_R_II", color="#059669", weight=2, minlen=1, constraint=true];
  N66 -> N67 [label="tibiofibular_trunk_R", color="#0F766E", weight=2, minlen=1, constraint=true];
  N67 -> N68 [label="posterior_tibial_R", color="#0F766E", weight=2, minlen=1, constraint=true];
  N58 -> N69 [label="external_iliac_L", color="#D97706", weight=2, minlen=1, constraint=true];
  N58 -> N70 [label="internal_iliac_L", color="#D97706", weight=2, minlen=1, constraint=true];
  N69 -> N71 [label="femoral_L_I", color="#059669", weight=2, minlen=1, constraint=true];
  N71 -> N72 [label="profunda_femoris_L", color="#059669", weight=2, minlen=1, constraint=true];
  N71 -> N73 [label="femoral_L_II", color="#059669", weight=2, minlen=1, constraint=true];
  N73 -> N74 [label="popliteal_L_I", color="#059669", weight=2, minlen=1, constraint=true];
  N74 -> N75 [label="anterior_tibial_L", color="#0F766E", weight=2, minlen=1, constraint=true];
  N74 -> N76 [label="popliteal_L_II", color="#059669", weight=2, minlen=1, constraint=true];
  N76 -> N77 [label="tibiofibular_trunk_L", color="#0F766E", weight=2, minlen=1, constraint=true];
  N77 -> N78 [label="posterior_tibial_L", color="#0F766E", weight=2, minlen=1, constraint=true];

  // Legend
  Legend [shape=plain, fixedsize=false, width=0, height=0, margin=0, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="2"><B>Body-Part Colors</B></TD></TR>
      <TR><TD><FONT COLOR="#EF4444">&#9608;&#9608;&#9608;</FONT></TD><TD>Head</TD></TR>
      <TR><TD><FONT COLOR="#F59E0B">&#9608;&#9608;&#9608;</FONT></TD><TD>Neck</TD></TR>
      <TR><TD><FONT COLOR="#0F766E">&#9608;&#9608;&#9608;</FONT></TD><TD>Upper Chest</TD></TR>
      <TR><TD><FONT COLOR="#0E7490">&#9608;&#9608;&#9608;</FONT></TD><TD>Chest</TD></TR>
      <TR><TD><FONT COLOR="#7C3AED">&#9608;&#9608;&#9608;</FONT></TD><TD>Spine</TD></TR>
      <TR><TD><FONT COLOR="#D97706">&#9608;&#9608;&#9608;</FONT></TD><TD>Hips</TD></TR>
      <TR><TD><FONT COLOR="#2563EB">&#9608;&#9608;&#9608;</FONT></TD><TD>Upper Arm</TD></TR>
      <TR><TD><FONT COLOR="#1D4ED8">&#9608;&#9608;&#9608;</FONT></TD><TD>Lower Arm</TD></TR>
      <TR><TD><FONT COLOR="#059669">&#9608;&#9608;&#9608;</FONT></TD><TD>Upper Leg</TD></TR>
      <TR><TD><FONT COLOR="#0F766E">&#9608;&#9608;&#9608;</FONT></TD><TD>Lower Leg</TD></TR>
    </TABLE>
  >];
  { rank=min; Legend }
}
